{
  "name": "sure-companion",
  "version": "0.1.0",
  "description": "Sidecar companion microservice for Sure personal finance",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "tsc",
    "build:ui": "npm --prefix ui run build",
    "build": "tsc && npm --prefix ui run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "googleapis": "^144.0.0",
    "imapflow": "^1.0.171",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
